# Môi trường DEV (máy lập trình viên)
# cp .env.development.example .env.development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=dev_user
DB_PASSWORD=<local-dev-password>

JWT_SECRET=<dev-only-secret>
SESSION_SECRET=<dev-only-secret>

# Dùng khóa SANDBOX/TEST của nhà cung cấp, không dùng khóa live
PAYMENT_API_KEY=<sandbox-api-key>
PAYMENT_WEBHOOK_SECRET=<sandbox-webhook-secret>

SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
STORAGE_ACCESS_KEY=<dev-storage-key>
STORAGE_SECRET_KEY=<dev-storage-secret>
