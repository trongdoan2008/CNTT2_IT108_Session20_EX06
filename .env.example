# ==========================================================
# .env.example  —  MẪU CHUNG (không chứa giá trị thật)
# Cách dùng:  cp .env.example .env   rồi điền giá trị của bạn
# Quy tắc: KHÔNG BAO GIỜ commit file .env thật.
# Xem thêm: .env.development.example, .env.test.example,
#           .env.production.example
# ==========================================================

# --- Ứng dụng ---
APP_ENV=development            # development | test | production
APP_NAME=ecommerce-shop
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Cơ sở dữ liệu ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# --- Xác thực / phiên ---
JWT_SECRET=<generate-with: openssl rand -hex 32>
SESSION_SECRET=<generate-with: openssl rand -hex 32>

# --- Cổng thanh toán ---
PAYMENT_API_KEY=<payment-provider-api-key>
PAYMENT_WEBHOOK_SECRET=<payment-webhook-secret>

# --- Dịch vụ bên thứ ba ---
SMTP_HOST=<smtp-host>
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
STORAGE_ACCESS_KEY=<storage-access-key>
STORAGE_SECRET_KEY=<storage-secret-key>
