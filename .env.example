# Môi trường dùng chung / DEV. Cách dùng: cp .env.example .env  (KHÔNG commit .env)
APP_ENV=development
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_dev
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

JWT_SECRET=<generate-with: openssl rand -hex 32>

# Dùng khóa SANDBOX của nhà cung cấp, không dùng khóa live
PAYMENT_API_KEY=<sandbox-api-key>
PAYMENT_WEBHOOK_SECRET=<sandbox-webhook-secret>

SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
