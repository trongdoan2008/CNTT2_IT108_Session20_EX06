# Môi trường PRODUCTION
# TUYỆT ĐỐI không tạo file .env.production trên repo hay máy cá nhân.
# Nạp biến qua Secret Manager / CI-CD Secrets / biến môi trường của nền tảng
# (GitHub Actions Secrets, AWS Secrets Manager, GCP Secret Manager, Vault...).
# File này chỉ liệt kê DANH SÁCH biến bắt buộc để team đối chiếu.
APP_ENV=production
APP_URL=https://<your-domain>
LOG_LEVEL=info

DB_HOST=<managed-db-host>
DB_PORT=5432
DB_NAME=<prod-db-name>
DB_USER=<from-secret-manager>
DB_PASSWORD=<from-secret-manager>
DB_SSL=true

JWT_SECRET=<from-secret-manager>
SESSION_SECRET=<from-secret-manager>

PAYMENT_API_KEY=<from-secret-manager>
PAYMENT_WEBHOOK_SECRET=<from-secret-manager>

SMTP_HOST=<from-secret-manager>
SMTP_USER=<from-secret-manager>
SMTP_PASSWORD=<from-secret-manager>
STORAGE_ACCESS_KEY=<from-secret-manager>
STORAGE_SECRET_KEY=<from-secret-manager>
