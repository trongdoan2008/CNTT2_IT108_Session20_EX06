# Môi trường TEST / CI / Staging
# Giá trị thật được nạp qua CI Secrets, KHÔNG ghi vào file.
# cp .env.test.example .env.test (chỉ để chạy cục bộ)
APP_ENV=test
APP_URL=http://localhost:3001
LOG_LEVEL=warn

DB_HOST=localhost
DB_PORT=5433
DB_NAME=ecommerce_test
DB_USER=test_user
DB_PASSWORD=<ci-secret>

JWT_SECRET=<ci-secret>
SESSION_SECRET=<ci-secret>

# Khóa sandbox, hoặc mock hoàn toàn trong test tự động
PAYMENT_API_KEY=<sandbox-api-key>
PAYMENT_WEBHOOK_SECRET=<sandbox-webhook-secret>

SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
STORAGE_ACCESS_KEY=<test-storage-key>
STORAGE_SECRET_KEY=<test-storage-secret>
