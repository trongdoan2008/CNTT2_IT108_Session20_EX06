# Môi trường TEST / CI. Giá trị thật nạp qua CI Secrets, không ghi vào file.
APP_ENV=test
APP_URL=http://localhost:3001

DB_HOST=localhost
DB_PORT=5433
DB_NAME=ecommerce_test
DB_USER=<ci-secret>
DB_PASSWORD=<ci-secret>

JWT_SECRET=<ci-secret>

# Khóa sandbox hoặc mock hoàn toàn
PAYMENT_API_KEY=<sandbox-api-key>
PAYMENT_WEBHOOK_SECRET=<sandbox-webhook-secret>

SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
